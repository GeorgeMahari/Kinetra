# Optional: copy to backend/.env to override defaults. Never put the password here.
# The password is read from the POSTGRES_PASSWORD environment variable.
KINETRA_ENVIRONMENT=development
KINETRA_LOG_LEVEL=INFO
KINETRA_DB_HOST=127.0.0.1
KINETRA_DB_PORT=5433
KINETRA_DB_USER=kinetra
KINETRA_DB_NAME=kinetra
# Wiped and re-migrated by the test suite. Must start with "kinetra_test".
KINETRA_TEST_DB_NAME=kinetra_test
KINETRA_CORS_ORIGINS=["http://localhost:8081"]

# Email for verification / password-reset codes.
# console = codes are printed in the API log (development only; refused in production).
KINETRA_EMAIL_BACKEND=console
# For real delivery (any SMTP relay):
# KINETRA_EMAIL_BACKEND=smtp
# KINETRA_SMTP_HOST=smtp.your-provider.com
# KINETRA_SMTP_PORT=587
# KINETRA_SMTP_USER=...
# KINETRA_EMAIL_FROM=Kinetra <no-reply@your-domain>
# The SMTP password is read only from the KINETRA_SMTP_PASSWORD environment variable (setx), never a file.
