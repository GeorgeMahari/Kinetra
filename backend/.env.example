# Optional: copy to backend/.env to override defaults. Never put the password here.
# The password is read from the POSTGRES_PASSWORD environment variable.
KINETRA_ENVIRONMENT=development
KINETRA_LOG_LEVEL=INFO
KINETRA_DB_HOST=127.0.0.1
KINETRA_DB_PORT=5433
KINETRA_DB_USER=kinetra
KINETRA_DB_NAME=kinetra
# Wiped and re-migrated by the test suite. Must start with "kinetra_test".
KINETRA_TEST_DB_NAME=kinetra_test
KINETRA_CORS_ORIGINS=["http://localhost:8081"]
