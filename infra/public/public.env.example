# Non-secret settings for the public deployment (Cloudflare Tunnel -> FastAPI on this computer).
# Copy to infra/public/.env.public (ignored by git) and fill in. No passwords or tokens here:
# secrets are read only from user environment variables (see docs/PRIVATE_DISTRIBUTION_GUIDE.md):
#   POSTGRES_PASSWORD, KINETRA_JWT_SECRET, KINETRA_SMTP_PASSWORD

# Public hostname of the API. Must be on a domain that is active in your Cloudflare account.
KINETRA_PUBLIC_HOSTNAME=
# Name of the Cloudflare named tunnel (created by infra/public/setup-tunnel.ps1).
KINETRA_TUNNEL_NAME=kinetra-api

# Outgoing email for verification and password-reset codes (production refuses console email).
KINETRA_SMTP_HOST=
KINETRA_SMTP_PORT=587
KINETRA_SMTP_USER=
KINETRA_EMAIL_FROM=

# Database used by the public API: "supabase" or "local" (the Docker PostgreSQL on this computer).
# Supabase: the API logs in as kinetra_app through the Session Pooler; its password is read from the
# KINETRA_APP_DB_PASSWORD user environment variable. See docs/SUPABASE_MIGRATION.md.
KINETRA_DB_TARGET=local
KINETRA_DB_HOST=
KINETRA_DB_PORT=5432
KINETRA_DB_NAME=postgres
KINETRA_DB_USER=
# require = encrypted. verify-full also checks the server: download the CA certificate from the
# Supabase dashboard (Database settings > SSL configuration) and set its path below.
KINETRA_DB_SSLMODE=require
KINETRA_DB_SSLROOTCERT=
